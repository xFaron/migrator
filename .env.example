# LLM provider (defaults to Google; pass provider="openrouter" to query_model() to switch)
OPENROUTER_API_KEY=""
OPENROUTER_API_URL="https://openrouter.ai/api/v1/chat/completions"
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

GOOGLE_API_KEY=""
GOOGLE_API_URL="https://generativelanguage.googleapis.com/v1beta/interactions"
GOOGLE_MODEL="models/gemma-4-31b-it"
GOOGLE_REASONING="minimal"

DATABASE_URL=""
# Postgres schema holding D' (the real database queries are migrated onto)
TARGET_PG_SCHEMA="public"
# Postgres schema where D (the LLM-generated source database) is instantiated
SOURCE_PG_SCHEMA="gen"
DB_PROMPT_PATH="prompts/generate_db_prompt.md"
QUERY_PROMPT_PATH="prompts/generate_query_prompt.md"
METHOD1_PROMPT_PATH="prompts/method1_prompt.md"
METHOD2_PROMPT_PATH="prompts/method2_prompt.md"
METHOD3_PROMPT_PATH="prompts/method3_prompt.md"
METHOD4_PROMPT_PATH="prompts/method4_prompt.md"
METHOD5_PROMPT_PATH="prompts/method5_prompt.md"
DEFAULT_K="15"
